# ==========================================
# SENTINEL Environment Variables Template
# ==========================================

# 1. Splunk Instance Configuration
SPLUNK_HOST=https://your-splunk-instance.splunkcloud.com
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=your_password
# Alternatively, use Bearer Token (recommended for Splunk Cloud)
SPLUNK_TOKEN=your_jwt_token
SPLUNK_VERIFY_TLS=true

# 2. Splunk Hosted Models (Foundation-Sec)
SPLUNK_ML_ENDPOINT=https://ml-api.splunkcloud.com/v1/models/foundation-sec-1.1-8b
SPLUNK_ML_TOKEN=your_ml_api_token

# 3. Threat Intelligence
VIRUSTOTAL_API_KEY=your_virustotal_api_key
ALIENVAULT_API_KEY=your_alienvault_api_key

# 4. Backend Configuration
REDIS_URL=redis://localhost:6379/0
API_V1_STR=/api/v1
PROJECT_NAME=SENTINEL_API
CORS_ORIGINS=["http://localhost:3000"]

# 5. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
